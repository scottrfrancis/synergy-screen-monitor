<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Service Label (unique identifier) -->
    <key>Label</key>
    <string>com.synergy.deskpresence</string>

    <!-- Publish macOS HID idle time to MQTT so Home Assistant can gate the office
         ceiling fan on whether Scott is actually at the desk. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Volumes/workspace/Synergy/desk_presence.py</string>
        <string>--broker</string>
        <string>192.168.4.3</string>
        <string>--port</string>
        <string>1883</string>
        <string>--topic</string>
        <string>desk/presence</string>
        <string>--interval</string>
        <string>30</string>
        <string>--idle-threshold</string>
        <string>900</string>
        <string>--host-name</string>
        <string>studio</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Volumes/workspace/Synergy</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>NetworkState</key>
        <true/>
    </dict>

    <!-- Logs live off /Volumes/workspace deliberately. That volume is itself mounted by
         com.local.mount-workspace, so this agent can start before it exists; if launchd
         cannot open its log paths the job fails silently instead of telling us why. -->
    <key>StandardOutPath</key>
    <string>/Users/scottfrancis/Library/Logs/desk-presence-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/scottfrancis/Library/Logs/desk-presence-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>Nice</key>
    <integer>0</integer>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
